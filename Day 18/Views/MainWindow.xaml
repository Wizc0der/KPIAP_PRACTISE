<Window x:Class="HotelBooking.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotelPro — Управление бронированием"
        Height="780" Width="1280" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏨" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="HotelPro" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤 " Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ManagerName}" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Выйти" Click="LogoutButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="White" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT ════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Tabs with rooms / bookings -->
            <Border Background="White" CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab bar -->
                    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
                        <TabItem Header="🛏️  Номера" FontSize="13" FontWeight="SemiBold">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Filters -->
                                <Border Background="#F8FAFC" Padding="16,10" BorderThickness="0,0,0,1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="Тип:" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,6,0"/>
                                            <ComboBox ItemsSource="{Binding RoomTypes}"
                                                      SelectedItem="{Binding FilterType}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="120"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding ShowOnlyAvailable}"
                                                      Content="Только свободные" FontSize="12"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Width="120" ToolTip="Поиск по номеру или описанию"/>
                                        </StackPanel>
                                        <Button Content="↻ Обновить" Command="{Binding RefreshCommand}"
                                                Margin="12,0,0,0"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource PrimaryBrush}"
                                                BorderThickness="1.5"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                Padding="10,5" Cursor="Hand" FontSize="12"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Room list -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ListView x:Name="RoomsListView"
                                              ItemsSource="{Binding Rooms}"
                                              SelectedItem="{Binding SelectedRoom}"
                                              ItemTemplate="{StaticResource RoomCardTemplate}"
                                              ItemContainerStyle="{StaticResource RoomListItemStyle}"
                                              Background="Transparent" BorderThickness="0"
                                              SelectionChanged="RoomsListView_SelectionChanged">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Margin="10"/>
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- Bookings tab -->
                        <TabItem Header="📋  Бронирования" FontSize="13" FontWeight="SemiBold">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cancel button -->
                                <Border Padding="16,10" BorderThickness="0,0,0,1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="❌  Отменить бронирование"
                                                Command="{Binding CancelBookingCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                IsEnabled="{Binding IsBookingSelected}"/>
                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="Выберите бронирование в таблице"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bookings DataGrid -->
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Bookings}"
                                          SelectedItem="{Binding SelectedBooking}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          AlternatingRowBackground="#F8FAFC"
                                          RowBackground="White"
                                          FontSize="12"
                                          BorderThickness="0"
                                          Margin="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="№ Номера" Binding="{Binding RoomNumber}" Width="80"/>
                                        <DataGridTextColumn Header="ФИО гостя" Binding="{Binding GuestFullName}" Width="180"/>
                                        <DataGridTextColumn Header="Телефон" Binding="{Binding GuestPhone}" Width="130"/>
                                        <DataGridTextColumn Header="Заезд" Binding="{Binding CheckIn, StringFormat=dd.MM.yyyy}" Width="90"/>
                                        <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOut, StringFormat=dd.MM.yyyy}" Width="90"/>
                                        <DataGridTextColumn Header="Ночей" Binding="{Binding Nights}" Width="60"/>
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat=N0}" Width="90"/>
                                        <DataGridTemplateColumn Header="Статус" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- RIGHT: Booking form -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Бронирование" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Заполните форму для нового бронирования"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Selected room info (OneWay) -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ВЫБРАННЫЙ НОМЕР" Style="{StaticResource FieldLabel}"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedRoomInfo}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Guest fields (TwoWay) -->
                        <TextBlock Text="ФИО ГОСТЯ *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GuestFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 ToolTip="Введите полное ФИО"/>

                        <TextBlock Text="ТЕЛЕФОН *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GuestPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"
                                 ToolTip="+7 (XXX) XXX-XX-XX"/>

                        <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GuestEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                        <!-- Dates -->
                        <TextBlock Text="ДАТА ЗАЕЗДА *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding CheckIn, Mode=TwoWay}"
                                    DisplayDateStart="{x:Static sys:DateTime.Today}"
                                    FontSize="13" Margin="0,0,0,12"
                                    xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

                        <TextBlock Text="ДАТА ВЫЕЗДА *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding CheckOut, Mode=TwoWay}"
                                    DisplayDateStart="{x:Static sys:DateTime.Today}"
                                    FontSize="13" Margin="0,0,0,12"
                                    xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

                        <!-- Total estimate -->
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Итого:" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EstimatedTotal}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Book button with ControlTemplate applied -->
                        <Button Content="🔖  Забронировать"
                                Command="{Binding BookRoomCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="44"
                                FontSize="15"
                                Margin="0,0,0,8"/>

                        <Button Content="Очистить форму"
                                Command="{Binding ClearFormCommand}"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="12" Cursor="Hand"
                                Padding="0,8" HorizontalAlignment="Stretch"
                                Margin="0,0,0,16">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Loading indicator -->
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="16"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BusyMessage}"
                                           FontSize="12" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <ProgressBar IsIndeterminate="True" Height="4"
                                             Margin="0,10,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Status message -->
                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="8"
                                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage[0]}" Value="❌">
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ STATUS BAR ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#1E3A5F" Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#93C5FD" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
