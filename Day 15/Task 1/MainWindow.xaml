<Window x:Class="Task_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Task_1"
        Title="Hotel Booking System" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <DataTemplate x:Key="RoomCardTemplate">
            <Border Background="White" CornerRadius="10" Padding="15" Margin="5"
                    BorderBrush="#E9ECEF" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Свободен">
                                <Setter Property="BorderBrush" Value="#D3F9D8"/>
                                <Setter Property="Background" Value="#F8FFF9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Забронирован">
                                <Setter Property="BorderBrush" Value="#FFE3E3"/>
                                <Setter Property="Background" Value="#FFF8F8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Number, StringFormat='№{0}'}" 
                                   FontSize="18" FontWeight="Bold" Foreground="#343A40"/>
                        <TextBlock Text="{Binding Type}" FontSize="14" Foreground="#6C757D" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Price, StringFormat={}{0:0} ₽/ночь}" 
                                   FontSize="14" Foreground="#5C7CFA" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="15" Padding="10,5" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Свободен">
                                        <Setter Property="Background" Value="#D3F9D8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Забронирован">
                                        <Setter Property="Background" Value="#FFE3E3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Свободен">
                                            <Setter Property="Text" Value="Свободен"/>
                                            <Setter Property="Foreground" Value="#2B8A3E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Забронирован">
                                            <Setter Property="Text" Value="Забронирован"/>
                                            <Setter Property="Foreground" Value="#C92A2A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="CustomButtonTemplate" TargetType="Button">
            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding BookCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <MenuItem Header="_Файл" Padding="10,5">
                <MenuItem Header="_Выход" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="_Бронирование" Padding="10,5">
                <MenuItem Header="_Забронировать" Command="{Binding BookCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Отменить" Command="{Binding CancelCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="_Справка" Padding="10,5">
                <MenuItem Header="_О программе" Click="AboutClick"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ Забронировать" Command="{Binding BookCommand}" 
                        Template="{StaticResource CustomButtonTemplate}"
                        Background="#5C7CFA" Foreground="White" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="❌ Отменить" Command="{Binding CancelCommand}" 
                        Template="{StaticResource CustomButtonTemplate}"
                        Background="#E03131" Foreground="White" Padding="15,8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Доступные номера" FontSize="20" 
                               FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rooms}"
                                      ItemTemplate="{StaticResource RoomCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Бронирование" FontSize="20" 
                               FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,20"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <TextBlock Text="ФИО гостя" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#495057" Margin="0,0,0,8"/>
                        <TextBox Height="40" Margin="0,0,0,15" Padding="12,0" 
                                 BorderThickness="1" BorderBrush="#E9ECEF" 
                                 Background="White" Foreground="#343A40"
                                 Text="{Binding SelectedBooking.GuestName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                        <TextBlock Text="Телефон" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#495057" Margin="0,0,0,8"/>
                        <TextBox Height="40" Margin="0,0,0,15" Padding="12,0" 
                                 BorderThickness="1" BorderBrush="#E9ECEF" 
                                 Background="White" Foreground="#343A40"
                                 Text="{Binding SelectedBooking.Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                        <TextBlock Text="Выберите номер" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#495057" Margin="0,0,0,8"/>
                        <ComboBox Height="40" Margin="0,0,0,15" 
                                  ItemsSource="{Binding Rooms}"
                                  SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                  BorderThickness="1" BorderBrush="#E9ECEF" 
                                  Background="White" Foreground="#343A40">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" Foreground="#343A40"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Дата заезда" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#495057" Margin="0,0,0,8"/>
                        <DatePicker Height="40" Margin="0,0,0,15" 
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding SelectedBooking.CheckIn, Mode=TwoWay}"/>

                        <TextBlock Text="Дата выезда" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#495057" Margin="0,0,0,8"/>
                        <DatePicker Height="40" Margin="0,0,0,20" 
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding SelectedBooking.CheckOut, Mode=TwoWay}"/>

                        <Border Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <TextBlock Text="{Binding TotalPrice, StringFormat='Итого: {0:0} ₽'}" 
                                       FontSize="16" FontWeight="Bold" Foreground="#5C7CFA" 
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Button Content="Забронировать" Command="{Binding BookCommand}" 
                                Template="{StaticResource CustomButtonTemplate}"
                                Background="#5C7CFA" Foreground="White" Height="45"/>

                        <TextBlock Text="{Binding StatusMessage}" Margin="0,15,0,0" TextWrapping="Wrap" 
                                   FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="#6C757D"/>

                        <!-- Индикатор загрузки -->
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" 
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Background" Value="#E9ECEF"/>
                                    <Setter Property="Foreground" Value="#5C7CFA"/>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0" Padding="15,10">
            <TextBlock Text="{Binding StatusMessage, StringFormat='Статус: {0}'}" Foreground="#6C757D"/>
        </Border>
    </Grid>
</Window>