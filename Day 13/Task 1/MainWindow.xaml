<Window x:Class="Task_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Booking System" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding BookCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#5C7CFA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C6EF5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CED4DA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Главное меню -->
        <Menu Grid.Row="0" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1">
            <MenuItem Header="_Файл" Padding="10,5">
                <MenuItem Header="_Выход" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="_Номера" Padding="10,5">
                <MenuItem Header="_Список номеров" Click="ShowRoomsClick"/>
                <MenuItem Header="_Добавить номер" Click="AddRoomClick"/>
            </MenuItem>
            <MenuItem Header="_Бронирование" Padding="10,5">
                <MenuItem Header="_Забронировать" Click="BookClick" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Редактировать" Click="EditClick" InputGestureText="Ctrl+E"/>
                <MenuItem Header="_Отменить" Click="CancelClick" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="_Настройки" Padding="10,5">
                <MenuItem Header="_О программе" Click="AboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ Забронировать" Command="{Binding BookCommand}" ToolTip="Ctrl+N"/>
                <Button Content="✏️ Редактировать" Command="{Binding EditCommand}" ToolTip="Ctrl+E"/>
                <Button Content="❌ Отменить" Command="{Binding CancelCommand}" ToolTip="Ctrl+D" Background="#E03131"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Список бронирований" FontSize="20" FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,15"/>

                <DataGrid Grid.Row="1" x:Name="dgBookings" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" RowHeight="45" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#6C757D"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E7F5FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ Брони" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Гость" Binding="{Binding GuestName}" Width="150"/>
                        <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="70"/>
                        <DataGridTextColumn Header="Заезд" Binding="{Binding CheckIn, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                        <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:0} ₽}" Width="90"/>
                        <DataGridTemplateColumn Header="Статус" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Активна">
                                                        <Setter Property="Background" Value="#D3F9D8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Отменена">
                                                        <Setter Property="Background" Value="#FFE3E3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Border CornerRadius="12" Padding="8,4">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Активна">
                                                                <Setter Property="Foreground" Value="#2B8A3E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Отменена">
                                                                <Setter Property="Foreground" Value="#C92A2A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0" Padding="15,10">
            <TextBlock x:Name="txtStatus" Text="Готов к работе" Foreground="#6C757D"/>
        </Border>
    </Grid>
</Window>