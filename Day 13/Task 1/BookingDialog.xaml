<Window x:Class="Task_1.BookingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование номера" Height="581" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F9FA">

    <Border Background="White" CornerRadius="12" Margin="20">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Бронирование номера" FontSize="20" FontWeight="SemiBold" Foreground="#343A40" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <TextBlock Text="ФИО гостя" FontSize="13" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                <TextBox x:Name="txtFullName" Height="40" Margin="0,0,0,15" Padding="12,0" BorderThickness="1" BorderBrush="#E9ECEF" Background="#FAFAFA"/>

                <TextBlock Text="Номер" FontSize="13" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                <ComboBox x:Name="cmbRoom" Height="40" Margin="0,0,0,15" Padding="12,0" BorderThickness="1" BorderBrush="#E9ECEF" Background="#FAFAFA"/>

                <TextBlock Text="Дата заезда" FontSize="13" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                <DatePicker x:Name="dpCheckIn" Height="40" Margin="0,0,0,15" 
                            BorderThickness="1" BorderBrush="#E9ECEF" Background="White"
                            SelectedDateFormat="Short"/>

                <TextBlock Text="Дата выезда" FontSize="13" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,8"/>
                <DatePicker x:Name="dpCheckOut" Height="40" Margin="0,0,0,20" 
                            BorderThickness="1" BorderBrush="#E9ECEF" Background="White"
                            SelectedDateFormat="Short"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="100" Height="40" Background="#6C757D" Click="CancelClick"/>
                <Button Content="Сохранить" Width="100" Height="40" Margin="10,0,0,0" Click="SaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>